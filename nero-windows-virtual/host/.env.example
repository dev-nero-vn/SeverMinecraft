# Bắt buộc: thay bằng chuỗi bí mật riêng của bạn.
NERO_API_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Windows host example: đổi đường dẫn theo máy của bạn.
NERO_ISO_PATH=C:\ISO\Windows11.iso
NERO_VM_DIR=C:\NeroWindowsCloud
NERO_QEMU_BIN=C:\Program Files\qemu\qemu-system-x86_64.exe
NERO_QEMU_IMG_BIN=C:\Program Files\qemu\qemu-img.exe
NERO_SWTPM_BIN=C:\Program Files\swtpm\bin\swtpm.exe
NERO_OVMF_CODE=C:\Program Files\qemu\share\edk2-x86_64-code-secboot.fd
NERO_OVMF_VARS=C:\Program Files\qemu\share\edk2-x86_64-vars
NERO_ACCEL=whpx

# Linux host example: uncomment and set valid paths instead.
# NERO_ISO_PATH=/srv/iso/Windows11.iso
# NERO_VM_DIR=/srv/nero-windows
# NERO_QEMU_BIN=/usr/bin/qemu-system-x86_64
# NERO_QEMU_IMG_BIN=/usr/bin/qemu-img
# NERO_SWTPM_BIN=/usr/bin/swtpm
# NERO_OVMF_CODE=/usr/share/OVMF/OVMF_CODE_4M.secboot.fd
# NERO_OVMF_VARS=/usr/share/OVMF/OVMF_VARS_4M.ms.fd
# NERO_ACCEL=kvm

NERO_CPUS=4
NERO_MEMORY_MB=6144
NERO_DISK_SIZE=80G
NERO_VNC_PORT=5901
NERO_TPM_SERVER_PORT=2321
NERO_TPM_CONTROL_PORT=2322
