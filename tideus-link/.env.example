# Copy to .env on the Linux host. Never commit .env.
NODE_ENV=production
HOST=0.0.0.0
PORT=8787

# Use a unique password and at least 32 random bytes for the session secret.
DASHBOARD_USER=owner
DASHBOARD_PASSWORD=replace-with-a-long-random-password
DASHBOARD_SESSION_SECRET=replace-with-at-least-32-random-bytes

# Discord bot. Enable Message Content Intent in the Discord Developer Portal.
DISCORD_BOT_TOKEN=
DISCORD_OWNER_IDS=

# Valid command messages are deleted when Discord grants MANAGE_MESSAGES.
DELETE_COMMAND_MESSAGES=true

# AI stays disabled until a provider and age/terms eligibility are confirmed.
AI_ENABLED=false