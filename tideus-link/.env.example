# Copy to .env on Linux. Never commit .env.
NODE_ENV=production
HOST=0.0.0.0
PORT=8787

# Use a unique, strong owner password and a random session secret (32+ bytes).
DASHBOARD_USER=owner
DASHBOARD_PASSWORD=replace-with-a-long-random-password
DASHBOARD_SESSION_SECRET=replace-with-at-least-32-random-bytes

# Future provider adapters: configure only after creating official apps and OAuth/webhook settings.
# ZALO_OA_CLIENT_ID=
# ZALO_OA_CLIENT_SECRET=
# META_APP_ID=
# META_APP_SECRET=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=

# AI remains disabled in this starter. Never store provider keys in Git.
AI_ENABLED=false